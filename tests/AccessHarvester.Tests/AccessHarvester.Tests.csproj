<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AccessHarvester.Core\AccessHarvester.Core.csproj" />
    <ProjectReference Include="..\..\AccessHarvester.Access\AccessHarvester.Access.csproj" />
    <!-- Cli reference enables the report-baseline integration test to drive
         ReportBaselineCommand.Run end-to-end in-process. -->
    <ProjectReference Include="..\..\AccessHarvester.Cli\AccessHarvester.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SyntheticDbs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
