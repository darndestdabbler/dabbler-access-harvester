  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\n\u0027 ============================================================================\r\n\u0027  frmServiceRateLimits\r\n\u0027 ----------------------------------------------------------------------------\r\n\u0027  Continuous form bound to tblServiceRateLimits, filtered by fiscal year\r\n\u0027  via cboFilterFiscalYear. Direct-edit (not a listbox \u002B popup pattern).\r\n\u0027\r\n\u0027  btnCopyRateLimits copies all rate-limit entries from the most recent\r\n\u0027  populated prior FY into the FY currently selected in cboFilterFiscalYear.\r\n\u0027 ============================================================================\r\nPrivate Sub Form_Load()\r\n    Me.cboFilterFiscalYear = basUtilities.GetCurrentFiscalYear()\r\n    ApplyFiscalYearFilter\r\n    UpdateCopyButtonState\r\nEnd Sub\r\nPrivate Sub cboFilterFiscalYear_AfterUpdate()\r\n    ApplyFiscalYearFilter\r\n    UpdateCopyButtonState\r\nEnd Sub\r\nPrivate Sub ApplyFiscalYearFilter()\r\n    If Not IsNull(Me.cboFilterFiscalYear) Then\r\n        Me.Filter = \u0022FiscalYear=\u0022 \u0026 Me.cboFilterFiscalYear\r\n        Me.FilterOn = True\r\n    Else\r\n        Me.FilterOn = False\r\n    End If\r\nEnd Sub\r\n\u0027 ============================================================================\r\n\u0027  Validation\r\n\u0027 ============================================================================\r\nPrivate Sub txtMaxRatePerHour_BeforeUpdate(Cancel As Integer)\r\n    If Not IsNull(Me.txtMaxRatePerHour) Then\r\n        If Me.txtMaxRatePerHour \u003C= 0 Or Me.txtMaxRatePerHour \u003E 500 Then\r\n            MsgBox \u0022Rate must be between $0.01 and $500.00.\u0022, vbExclamation, \u0022Validation\u0022\r\n            Cancel = True\r\n        End If\r\n    End If\r\nEnd Sub\r\n\u0027 ----------------------------------------------------------------------------\r\n\u0027  Form_BeforeUpdate\r\n\u0027\r\n\u0027  Fires when ANY row on this continuous form is committed (tab away, save\r\n\u0027  button, navigate, etc.). Catches:\r\n\u0027    - missing ServiceID (relational FK constraint would catch it too,\r\n\u0027      but the message here is friendlier)\r\n\u0027    - missing or non-positive MaxRatePerHour\r\n\u0027    - missing FiscalYear (shouldn\u0027t happen ? the row inherits the filter ?\r\n\u0027      but defensive)\r\n\u0027    - duplicate (ServiceID, FiscalYear) for any other row in the table\r\n\u0027\r\n\u0027  Note: txtMaxRatePerHour_BeforeUpdate already validates the rate range\r\n\u0027  on field exit, so this BeforeUpdate is the second line of defense for\r\n\u0027  someone who pastes a value or commits without typing.\r\n\u0027 ----------------------------------------------------------------------------\r\nPrivate Sub Form_BeforeUpdate(Cancel As Integer)\r\n    If IsNull(Me!ServiceID) Then\r\n        MsgBox \u0022Please select a service.\u0022, vbExclamation, \u0022Validation\u0022\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    If IsNull(Me!FiscalYear) Then\r\n        Me!FiscalYear = Nz(Me.cboFilterFiscalYear, basUtilities.GetCurrentFiscalYear())\r\n    End If\r\n    If IsNull(Me!MaxRatePerHour) Or Me!MaxRatePerHour \u003C= 0 Then\r\n        MsgBox \u0022Please enter a positive maximum rate per hour.\u0022, _\r\n               vbExclamation, \u0022Validation\u0022\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    If Me!MaxRatePerHour \u003E 500 Then\r\n        MsgBox \u0022Rate exceeds the $500.00 ceiling.\u0022, vbExclamation, \u0022Validation\u0022\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    \u0027 Duplicate check (same service, same FY, different row).\r\n    Dim selfID As Long\r\n    selfID = Nz(Me!ServiceRateLimitID, 0)\r\n    If DCount(\u0022*\u0022, \u0022tblServiceRateLimits\u0022, _\r\n              \u0022ServiceID=\u0022 \u0026 Me!ServiceID \u0026 _\r\n              \u0022 AND FiscalYear=\u0022 \u0026 Me!FiscalYear \u0026 _\r\n              \u0022 AND ServiceRateLimitID\u003C\u003E\u0022 \u0026 selfID) \u003E 0 Then\r\n        MsgBox \u0022A rate limit for this service in FY\u0022 \u0026 Me!FiscalYear \u0026 _\r\n               \u0022 already exists.\u0022, vbExclamation, \u0022Duplicate\u0022\r\n        Cancel = True\r\n    End If\r\nEnd Sub\r\n\u0027 ----------------------------------------------------------------------------\r\n\u0027  Form_BeforeDelConfirm\r\n\u0027\r\n\u0027  Fires after the user presses Delete on a row, before Access shows its\r\n\u0027  generic \u0022You are about to delete N record(s)...\u0022 prompt. Two responsibilities:\r\n\u0027    1. Block the delete if any tblProviderServiceCatalog row in the same FY\r\n\u0027       references this service (the rate limit governs those rows).\r\n\u0027    2. Suppress Access\u0027s stock prompt and show a more informative one.\r\n\u0027\r\n\u0027  The \u0022in-use\u0022 check intentionally scopes to the same FiscalYear: rate\r\n\u0027  limits for FY2024 don\u0027t constrain FY2025 catalog rows, so a FY2024\r\n\u0027  limit can be deleted even if FY2025 has matching catalog entries.\r\n\u0027 ----------------------------------------------------------------------------\r\nPrivate Sub Form_BeforeDelConfirm(Cancel As Integer, Response As Integer)\r\n    Dim inUse As Long\r\n    inUse = DCount(\u0022*\u0022, \u0022tblProviderServiceCatalog\u0022, _\r\n                   \u0022ServiceID=\u0022 \u0026 Me!ServiceID \u0026 _\r\n                   \u0022 AND FiscalYear=\u0022 \u0026 Me!FiscalYear)\r\n    If inUse \u003E 0 Then\r\n        MsgBox \u0022Cannot delete this rate limit.\u0022 \u0026 vbCrLf \u0026 vbCrLf \u0026 _\r\n               inUse \u0026 \u0022 provider catalog entry(ies) in FY\u0022 \u0026 Me!FiscalYear \u0026 _\r\n               \u0022 are governed by it. Remove or reassign those first.\u0022, _\r\n               vbExclamation, \u0022Rate Limit In Use\u0022\r\n        Cancel = True\r\n        Response = acDataErrContinue\r\n        Exit Sub\r\n    End If\r\n    \u0027 Replace Access\u0027s stock prompt with a clearer one.\r\n    If MsgBox(\u0022Delete the rate limit for service \u0022 \u0026 _\r\n              Nz(DLookup(\u0022ServiceName\u0022, \u0022tblServices\u0022, _\r\n                         \u0022ServiceID=\u0022 \u0026 Me!ServiceID), \u0022(unknown)\u0022) \u0026 _\r\n              \u0022 in FY\u0022 \u0026 Me!FiscalYear \u0026 \u0022?\u0022, _\r\n              vbYesNo \u002B vbQuestion \u002B vbDefaultButton2, _\r\n              \u0022Confirm Delete\u0022) = vbNo Then\r\n        Cancel = True\r\n    End If\r\n    Response = acDataErrContinue   \u0027 suppress Access\u0027s own prompt\r\nEnd Sub\r\n\u0027 ============================================================================\r\n\u0027  Copy from prior FY\r\n\u0027 ============================================================================\r\nPrivate Sub btnCopyRateLimits_Click()\r\n    Dim targetFY As Long\r\n    targetFY = Nz(Me.cboFilterFiscalYear, basUtilities.GetCurrentFiscalYear())\r\n    Dim srcVar As Variant\r\n    srcVar = basDataOperations.MostRecentPopulatedFY( _\r\n                \u0022tblServiceRateLimits\u0022, \u0022\u0022, targetFY)\r\n    If IsNull(srcVar) Then\r\n        MsgBox \u0022No prior fiscal year has service rate limits to copy.\u0022, _\r\n               vbInformation, \u0022Nothing to Copy\u0022\r\n        Exit Sub\r\n    End If\r\n    Dim sourceFY As Integer\r\n    sourceFY = CInt(srcVar)\r\n    Dim srcCount As Long, tgtCount As Long\r\n    srcCount = DCount(\u0022*\u0022, \u0022tblServiceRateLimits\u0022, \u0022FiscalYear=\u0022 \u0026 sourceFY)\r\n    tgtCount = DCount(\u0022*\u0022, \u0022tblServiceRateLimits\u0022, \u0022FiscalYear=\u0022 \u0026 targetFY)\r\n    Dim msg As String\r\n    msg = \u0022Copy \u0022 \u0026 srcCount \u0026 \u0022 rate limit entry(ies) from FY\u0022 \u0026 sourceFY \u0026 _\r\n          \u0022 into FY\u0022 \u0026 targetFY \u0026 \u0022?\u0022\r\n    If tgtCount \u003E 0 Then\r\n        msg = msg \u0026 vbCrLf \u0026 vbCrLf \u0026 _\r\n              \u0022FY\u0022 \u0026 targetFY \u0026 \u0022 currently has \u0022 \u0026 tgtCount \u0026 _\r\n              \u0022 rate limit entry(ies). They will be replaced.\u0022\r\n    End If\r\n    If MsgBox(msg, vbQuestion \u002B vbOKCancel \u002B vbDefaultButton1, _\r\n              \u0022Copy from FY\u0022 \u0026 sourceFY) \u003C\u003E vbOK Then\r\n        Exit Sub\r\n    End If\r\n    On Error GoTo Failed\r\n    Dim n As Long\r\n    n = basDataOperations.CopyServiceRateLimits( _\r\n                sourceFY, CInt(targetFY), overwrite:=True)\r\n    MsgBox n \u0026 \u0022 rate limit entry(ies) copied from FY\u0022 \u0026 sourceFY \u0026 _\r\n           \u0022 to FY\u0022 \u0026 targetFY \u0026 \u0022.\u0022, vbInformation, \u0022Copy Complete\u0022\r\n    Me.Requery\r\n    UpdateCopyButtonState\r\n    Exit Sub\r\nFailed:\r\n    Select Case Err.Number\r\n        Case basDataOperations.ERR_CANCELED\r\n            \u0027 silent\r\n        Case basDataOperations.ERR_SAME_FY\r\n            MsgBox Err.Description, vbExclamation, \u0022Invalid Fiscal Years\u0022\r\n        Case Else\r\n            MsgBox \u0022Error copying rate limits: \u0022 \u0026 Err.Description, vbCritical\r\n    End Select\r\nEnd Sub\r\n\u0027 ----------------------------------------------------------------------------\r\n\u0027  Refreshes btnCopyRateLimits\u0027s label and visibility based on the currently\r\n\u0027  selected target FY and what prior-year data exists.\r\n\u0027 ----------------------------------------------------------------------------\r\nPrivate Sub UpdateCopyButtonState()\r\n    On Error Resume Next   \u0027 button may not exist yet during form load\r\n    Dim targetFY As Long\r\n    targetFY = Nz(Me.cboFilterFiscalYear, basUtilities.GetCurrentFiscalYear())\r\n    Dim srcVar As Variant\r\n    srcVar = basDataOperations.MostRecentPopulatedFY( _\r\n                \u0022tblServiceRateLimits\u0022, \u0022\u0022, targetFY)\r\n    If IsNull(srcVar) Then\r\n        Me.btnCopyRateLimits.Visible = False\r\n    Else\r\n        Me.btnCopyRateLimits.Caption = \u0022Copy from FY\u0022 \u0026 CLng(srcVar)\r\n        Me.btnCopyRateLimits.Visible = True\r\n    End If\r\nEnd Sub\r\n",
