  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate Sub PopulateClientList(Optional whereClauseSql As String = \u0022\u0022)\r\n    Dim baseSql As String\r\n    baseSql = _\r\n        \u0022SELECT ClientID AS ID, \u0022 \u0026 _\r\n               \u0022FirstName \u0026 \u0027 \u0027 \u0026 LastName AS [Client Name], \u0022 \u0026 _\r\n               \u0022Phone, \u0022 \u0026 _\r\n               \u0022City, \u0022 \u0026 _\r\n               \u0022StateCode AS State, \u0022 \u0026 _\r\n               \u0022IsActive AS Active \u0022 \u0026 _\r\n        \u0022FROM tblClients \u0022 \u0026 whereClauseSql\r\n    Me.lstClientList.RowSource = basListHelpers.BuildAddableRowSource( _\r\n        dataSelect:=baseSql, _\r\n        addLabel:=\u0022(Add new client...)\u0022, _\r\n        dataColCount:=6, _\r\n        orderBy:=\u00222\u0022)          \u0027 by Client Name; \u0022(Add new...\u0022 sorts before letters\r\n    Me.lstClientList.Requery\r\nEnd Sub\r\nPrivate Sub lstClientList_DblClick(Cancel As Integer)\r\n    basListHelpers.OpenDetailFromList Me.lstClientList, \u0022frmClientDetail\u0022\r\nEnd Sub\r\nPrivate Sub btnAddNew_Click()\r\n    DoCmd.OpenForm \u0022frmClientDetail\u0022, acNormal, , , acFormAdd\r\n    Me.lstClientList.Requery\r\nEnd Sub\r\nPrivate Sub Form_Activate()\r\n    Me.lstClientList.Requery\r\nEnd Sub\r\nPrivate Sub txtFilterName_KeyPress(KeyAscii As Integer)\r\n    If KeyAscii = 13 Then\r\n        KeyAscii = 0\r\n        btnSearch_Click\r\n    End If\r\nEnd Sub\r\nPrivate Sub cboFilterState_AfterUpdate()\r\n    \u0027 Cascading dropdown: rebuild city list for selected state\r\n    If IsNull(Me.cboFilterState) Then\r\n        Me.cboFilterCity.RowSource = \u0022\u0022\r\n    Else\r\n        Me.cboFilterCity.RowSource = _\r\n            \u0022SELECT DISTINCT City FROM tblClients \u0022 \u0026 _\r\n            \u0022WHERE StateCode=\u0022 \u0026 SqlQuote(Me.cboFilterState) \u0026 \u0022 AND City Is Not Null \u0022 \u0026 _\r\n            \u0022ORDER BY City\u0022\r\n    End If\r\n    Me.cboFilterCity = Null\r\n    Me.cboFilterCity.Requery\r\nEnd Sub\r\nPrivate Sub cboFilterState_DblClick(Cancel As Integer)\r\n    Me.cboFilterState = Null\r\n    Me.cboFilterCity.RowSource = \u0022\u0022\r\n    Me.cboFilterCity = Null\r\n    Me.cboFilterCity.Requery\r\nEnd Sub\r\nPrivate Sub cboFilterCity_NotInList(NewData As String, Response As Integer)\r\n    Response = acDataErrContinue\r\n    MsgBox \u0022Please select a city from the list.\u0022, vbExclamation\r\nEnd Sub\r\nPrivate Sub btnSearch_Click()\r\n    Dim where() As String\r\n    Dim i As Integer\r\n    i = -1\r\n    If Not IsNull(Me.txtFilterName) And Me.txtFilterName \u003C\u003E \u0022\u0022 Then\r\n        i = i \u002B 1\r\n        ReDim Preserve where(i)\r\n        where(i) = \u0022FirstName LIKE \u0022 \u0026 SqlQuote(Me.txtFilterName, \u0022*\u0022, \u0022*\u0022) \u0026 _\r\n            \u0022 OR LastName LIKE \u0022 \u0026 SqlQuote(Me.txtFilterName, \u0022*\u0022, \u0022*\u0022)\r\n    End If\r\n    If Not IsNull(Me.cboFilterState) Then\r\n        i = i \u002B 1\r\n        ReDim Preserve where(i)\r\n        where(i) = \u0022StateCode=\u0022 \u0026 SqlQuote(Me.cboFilterState)\r\n    End If\r\n    If Not IsNull(Me.cboFilterCity) Then\r\n        i = i \u002B 1\r\n        ReDim Preserve where(i)\r\n        where(i) = \u0022City=\u0022 \u0026 SqlQuote(Me.cboFilterCity)\r\n    End If\r\n    If Not IsNull(Me.cboFilterStatus) Then\r\n        i = i \u002B 1\r\n        ReDim Preserve where(i)\r\n        Select Case Me.cboFilterStatus\r\n            Case \u0022Active\u0022\r\n                where(i) = \u0022IsActive=True\u0022\r\n            Case \u0022Inactive\u0022\r\n                where(i) = \u0022IsActive=False\u0022\r\n        End Select\r\n    End If\r\n    PopulateClientList basUtilities.whereClause(where)\r\nEnd Sub\r\nPrivate Sub btnClear_Click()\r\n    Me.txtFilterName = Null\r\n    Me.cboFilterState = Null\r\n    Me.cboFilterCity = Null\r\n    Me.cboFilterCity.RowSource = \u0022\u0022\r\n    Me.cboFilterStatus = \u0022Active\u0022\r\n    PopulateClientList \u0022WHERE IsActive=True\u0022\r\nEnd Sub\r\n"
}