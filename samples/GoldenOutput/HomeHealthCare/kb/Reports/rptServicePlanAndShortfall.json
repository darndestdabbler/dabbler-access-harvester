  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate m_ClientID As Long\r\nPrivate m_FiscalYear As Integer\r\nPrivate m_RunningBudget As Currency\r\nPrivate Sub Report_Open(Cancel As Integer)\r\n    DoCmd.OpenForm \u0022frmReportParam_ClientFY\u0022, , , , , acDialog\r\n    If Not IsLoaded(\u0022frmReportParam_ClientFY\u0022) Then\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    m_ClientID = Forms!frmReportParam_ClientFY!cboClient\r\n    m_FiscalYear = Forms!frmReportParam_ClientFY!cboFiscalYear\r\n    Me.RecordSource = \u0022SELECT * FROM tblClients WHERE ClientID = \u0022 \u0026 m_ClientID\r\n    DoCmd.Close acForm, \u0022frmReportParam_ClientFY\u0022\r\n    TempVars!repCID = m_ClientID\r\n    TempVars!repFY = m_FiscalYear\r\n    Me.lstTotals.RowSource = basUtilities.GetRptClientServicePlanAndShortFallTotals(m_ClientID, m_FiscalYear)\r\nEnd Sub\r\nPrivate Sub Report_NoData(Cancel As Integer)\r\n    MsgBox \u0022No data found for this client and fiscal year.\u0022, vbInformation\r\n    Cancel = True\r\nEnd Sub\r\nPrivate Function IsLoaded(ByVal strFormName As String) As Boolean\r\n    Dim frm As Access.Form\r\n    For Each frm In Application.Forms\r\n        If frm.name = strFormName Then\r\n            IsLoaded = True\r\n            Exit Function\r\n        End If\r\n    Next\r\n    IsLoaded = False\r\nEnd Function\r\n"
