{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-File", ".claude/hooks/guard-dotnet-parallel.ps1"],
            "timeout": 15,
            "statusMessage": "dotnet sequential-run guard"
          }
        ]
      }
    ]
  }
}
