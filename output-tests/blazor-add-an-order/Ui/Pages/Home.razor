@namespace BlazorAddAnOrder.Ui.Pages
@page "/"
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Add an Order — Pilot Scaffold</MudText>

<MudText Class="mb-4">
    The Session 1 scaffold proves the UI can reach the in-process REST
    boundary. The card below shows the response from
    <code>GET /api/health</code> via the named HttpClient.
</MudText>

<MudCard Outlined="true" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Service health</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (_status is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.caption" Class="mt-2">Calling /api/health …</MudText>
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Success">
                Service responded with <strong>@_status.Status</strong>.
            </MudAlert>
        }
    </MudCardContent>
</MudCard>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/orders/new">
    Create a new order
</MudButton>

@code {
    private HealthResponse? _status;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("services");
            _status = await client.GetFromJsonAsync<HealthResponse>("api/health");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
