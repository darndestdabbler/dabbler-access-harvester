  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate m_FiscalYear As Integer\r\nPrivate Sub Report_Open(Cancel As Integer)\r\n    DoCmd.OpenForm \u0022frmReportParam_FY\u0022, , , , , acDialog\r\n    If Not IsLoaded(\u0022frmReportParam_FY\u0022) Then\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    m_FiscalYear = Forms!frmReportParam_FY!cboFiscalYear\r\n    Me.txtGrandTotal.ControlSource = GetDSumForGrandTotal(m_FiscalYear)\r\n    Me.RecordSource = SqlForFiscalYear(m_FiscalYear)\r\n    DoCmd.Close acForm, \u0022frmReportParam_FY\u0022\r\nEnd Sub\r\nPrivate Function GetDSumForGrandTotal(FiscalYear As Integer) As String\r\n    Dim str As String\r\n    str = \u0022=FormatCurrency(Nz(DSum(\u0022 \u0026 Chr(34) \u0026 \u0022TotalCost\u0022 \u0026 Chr(34) \u0026 \u0022, \u0022 \u0026 Chr(34) \u0026 \u0022qryCosts_ByFiscalYear\u0022 \u0026 Chr(34) \u0026 _\r\n        \u0022, \u0022 \u0026 Chr(34) \u0026 \u0022FiscalYear=\u0022 \u0026 FiscalYear \u0026 Chr(34) \u0026 \u0022), 0))\u0022\r\n    GetDSumForGrandTotal = str\r\nEnd Function\r\nPrivate Function SqlForFiscalYear(FiscalYear As Integer) As String\r\n    Dim sql As String\r\n    sql = \u0022SELECT \u0022 \u0026 _\r\n            \u0022p.ProviderID, \u0022 \u0026 _\r\n            \u0022p.ProviderName, \u0022 \u0026 _\r\n            \u0022p.TotalCost, p.PctCost \u0022 \u0026 _\r\n            \u0022FROM qryProviderServiceCosts_ByFiscalYear p \u0022 \u0026 _\r\n            \u0022WHERE p.FiscalYear = \u0022 \u0026 FiscalYear \u0026 \u0022;\u0022\r\n    SqlForFiscalYear = sql\r\nEnd Function\r\nPrivate Sub Report_NoData(Cancel As Integer)\r\n    MsgBox \u0022No cost data found for this fiscal year.\u0022, vbInformation\r\n    Cancel = True\r\nEnd Sub\r\nPrivate Function IsLoaded(ByVal strFormName As String) As Boolean\r\n    Dim frm As Access.Form\r\n    For Each frm In Application.Forms\r\n        If frm.name = strFormName Then\r\n            IsLoaded = True\r\n            Exit Function\r\n        End If\r\n    Next\r\n    IsLoaded = False\r\nEnd Function\r\n",
