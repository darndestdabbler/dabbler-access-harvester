  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate m_ProviderID As Long\r\nPrivate m_FiscalYear As Integer\r\nPrivate Sub Report_Open(Cancel As Integer)\r\n    DoCmd.OpenForm \u0022frmReportParam_ProviderFY\u0022, , , , , acDialog\r\n    If Not IsLoaded(\u0022frmReportParam_ProviderFY\u0022) Then\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    m_ProviderID = Forms!frmReportParam_ProviderFY!cboProvider\r\n    m_FiscalYear = Forms!frmReportParam_ProviderFY!cboFiscalYear\r\n    Me.RecordSource = \u0022SELECT ProviderName, FiscalYear, ServiceName, ClientName, WeeklyHours, AnnualEstCost \u0022 \u0026 _\r\n        \u0022FROM qryServicePlansByService \u0022 \u0026 _\r\n        \u0022WHERE ProviderID = \u0022 \u0026 m_ProviderID \u0026 \u0022 AND FiscalYear = \u0022 \u0026 m_FiscalYear \u0026 _\r\n        \u0022 ORDER BY ServiceName, ClientName\u0022\r\n    DoCmd.Close acForm, \u0022frmReportParam_ProviderFY\u0022\r\nEnd Sub\r\nPrivate Sub Report_NoData(Cancel As Integer)\r\n    MsgBox \u0022No plan data found for this provider and fiscal year.\u0022, vbInformation\r\n    Cancel = True\r\nEnd Sub\r\nPrivate Function IsLoaded(ByVal strFormName As String) As Boolean\r\n    Dim frm As Access.Form\r\n    For Each frm In Application.Forms\r\n        If frm.name = strFormName Then\r\n            IsLoaded = True\r\n            Exit Function\r\n        End If\r\n    Next\r\n    IsLoaded = False\r\nEnd Function\r\n",
