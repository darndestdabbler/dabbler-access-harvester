# Python virtual environment (created locally; never committed)
.venv/

# Python bytecode caches
__pycache__/
*.pyc
*.pyo

# AI router runtime state — local only.
# (Legacy ai-router/ paths kept here for any historical artifacts that
# slipped through; the active path is ai_router/ post-Set-010.)
ai-router/router-state.db
ai_router/router-state.db

# Router metrics log — append-only, grows with every route() call.
# Treat as local telemetry; archive or rotate manually when large.
ai-router/router-metrics.jsonl
ai_router/router-metrics.jsonl

# NorthwindDevEdition sample — Access mutates internal timestamps on every
# open, producing byte-level changes even on read-only access.
samples/NorthwindDevEdition.accdb

# Access lock files (created when Access opens a .accdb; never committed).
*.laccdb

# Northwind-derived YAML extracts — regenerated locally; not committed
samples/DatabaseYaml/NorthwindDevEdition.accdb/
samples/FormsAndReportsYaml/NorthwindDevEdition.accdb.yaml

# .NET build artifacts (will appear in later sessions)
**/bin/
**/obj/

# Visual Studio language-service cache (per-csproj). Regenerated on demand;
# not part of the repo state.
*.lscache

# Stray output directory `dotnet run --project tools/AccessHarvester.IrCodegen`
# creates when invoked with a relative output path that resolves against the
# csproj directory instead of the repo root. The intended output target is
# `output-tests/blazor-add-an-order/Ui/Pages/Generated/`; the nested copy
# under the tool itself is always wrong.
tools/AccessHarvester.IrCodegen/output-tests/

# IDE/editor metadata
.vs/
.vscode/

# Exception: the VS Code session-sets extension ships a launch.json so the
# F5 dev-mode workflow works out of the box. This .vscode is source code,
# not user-personal IDE state.
!tools/vscode-session-sets/.vscode/
!tools/vscode-session-sets/.vscode/**

# OS detritus
Thumbs.db
.DS_Store

# Local scratch / one-shot orchestrator scripts — not committed
tmp/
/session*.py

# Property-sheet inventory script outputs — regenerate on demand via
# `python tools/parse_success_inventory.py`; the committed verdict is
# `docs/session-sets/harvester-finish-canonical-parse-success-report/property-sheet-inventory.md`.
tools/_inventory_out/

# VS Code extension build artifacts — rebuild via `vsce package` per
# tools/vscode-session-sets/README.md
*.vsix

# Blazor pilot SQLite databases — runtime state, regenerated on startup
output-tests/blazor-add-an-order/Data/*.db
output-tests/blazor-add-an-order/Data/*.db-*

# Self-contained CLI publish output — produced by tools/publish/publish.ps1
# and consumed by the Session 2 packaged-binary smoke tests. The artifact
# is reproducible from source, so it is never committed.
/publish/

# Session-state migrator rollback artifacts (one-cycle backups).
# git history is the canonical rollback path; .bak files are
# short-window cruft. See ../dabbler-ai-orchestration/docs/v3-to-v4-rollback-procedure.md.
docs/session-sets/*/session-state.v3.bak.json
docs/session-sets/*/session-state.lwbak.json
