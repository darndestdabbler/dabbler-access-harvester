  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate m_Cancelled As Boolean\r\nPublic Property Get cancelled() As Boolean\r\n    cancelled = m_Cancelled\r\nEnd Property\r\nPrivate Sub btnOK_Click()\r\n        If IsNull(Me.cboProvider) Then\r\n        MsgBox \u0022Please select a provider.\u0022, vbExclamation\r\n        Me.cboProvider.SetFocus\r\n        Exit Sub\r\n    End If\r\n    If IsNull(Me.cboFiscalYear) Then\r\n        MsgBox \u0022Please select a fiscal year.\u0022, vbExclamation\r\n        Me.cboFiscalYear.SetFocus\r\n        Exit Sub\r\n    End If\r\n    Me.Visible = False\r\nEnd Sub\r\nPrivate Sub btnCancel_Click()\r\n    m_Cancelled = True\r\n    DoCmd.Close acForm, Me.name\r\nEnd Sub\r\n"
