  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\n\u0027 ============================================================================\r\n\u0027  frmServiceDetail\r\n\u0027 ----------------------------------------------------------------------------\r\n\u0027  Detail form for a single tblServices row.\r\n\u0027  Opened from frmServiceList (Add or Edit, modeless) and from the various\r\n\u0027  cboServiceID_NotInList handlers (Add only, modal via acDialog).\r\n\u0027\r\n\u0027  Controls (prefixed naming):\r\n\u0027     txtServiceID         (PK)\r\n\u0027     txtServiceCode       (required, unique)\r\n\u0027     txtServiceName       (required)\r\n\u0027     cboServiceCategory   (combo with inline row source ? not set in code)\r\n\u0027     txtDescription\r\n\u0027     chkActive            (default True)\r\n\u0027     btnSave / btnClose / btnDelete\r\n\u0027 ============================================================================\r\nPrivate Sub Form_BeforeUpdate(Cancel As Integer)\r\n    If Len(Nz(Me!ServiceCode, \u0022\u0022)) = 0 Then\r\n        MsgBox \u0022Service Code is required.\u0022, vbExclamation, \u0022Validation\u0022\r\n        Me.txtServiceCode.SetFocus\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    If Len(Nz(Me!ServiceName, \u0022\u0022)) = 0 Then\r\n        MsgBox \u0022Service Name is required.\u0022, vbExclamation, \u0022Validation\u0022\r\n        Me.txtServiceName.SetFocus\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    If Len(Nz(Me!ServiceCategory, \u0022\u0022)) = 0 Then\r\n        MsgBox \u0022Please select a service category.\u0022, vbExclamation, \u0022Validation\u0022\r\n        Me.cboServiceCategory.SetFocus\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    \u0027 Duplicate ServiceCode check (any other row).\r\n    Dim selfID As Long\r\n    selfID = Nz(Me!ServiceID, 0)\r\n    If DCount(\u0022*\u0022, \u0022tblServices\u0022, _\r\n              \u0022ServiceCode=\u0027\u0022 \u0026 Replace(Me!ServiceCode, \u0022\u0027\u0022, \u0022\u0027\u0027\u0022) \u0026 \u0022\u0027\u0022 \u0026 _\r\n              \u0022 AND ServiceID\u003C\u003E\u0022 \u0026 selfID) \u003E 0 Then\r\n        MsgBox \u0022Another service already has the code \u0027\u0022 \u0026 Me!ServiceCode \u0026 \u0022\u0027.\u0022, _\r\n               vbExclamation, \u0022Duplicate Code\u0022\r\n        Me.txtServiceCode.SetFocus\r\n        Cancel = True\r\n    End If\r\nEnd Sub\r\n\u0027 ============================================================================\r\n\u0027  Action buttons\r\n\u0027 ============================================================================\r\nPrivate Sub btnSave_Click()\r\n    On Error GoTo Failed\r\n    If Me.Dirty Then Me.Dirty = False    \u0027 fires Form_BeforeUpdate\r\n    DoCmd.Close acForm, Me.name\r\n    Exit Sub\r\nFailed:\r\n    \u0027 Validation canceled the save ? leave the form open.\r\nEnd Sub\r\nPrivate Sub btnClose_Click()\r\n    DoCmd.Close acForm, Me.name, acSavePrompt\r\nEnd Sub\r\nPrivate Sub btnDelete_Click()\r\n    If Me.NewRecord Then Exit Sub\r\n    \u0027 Block delete if any related rows reference this service.\r\n    Dim usedInLimits As Long, usedInCatalog As Long, usedInNeeds As Long, total As Long\r\n    usedInLimits = DCount(\u0022*\u0022, \u0022tblServiceRateLimits\u0022, \u0022ServiceID=\u0022 \u0026 Me!ServiceID)\r\n    usedInCatalog = DCount(\u0022*\u0022, \u0022tblProviderServiceCatalog\u0022, \u0022ServiceID=\u0022 \u0026 Me!ServiceID)\r\n    usedInNeeds = DCount(\u0022*\u0022, \u0022tblClientServiceNeeds\u0022, \u0022ServiceID=\u0022 \u0026 Me!ServiceID)\r\n    total = usedInLimits \u002B usedInCatalog \u002B usedInNeeds\r\n    If total \u003E 0 Then\r\n        MsgBox \u0022Cannot delete this service.\u0022 \u0026 vbCrLf \u0026 vbCrLf \u0026 _\r\n               usedInLimits \u0026 \u0022 rate limit row(s)\u0022 \u0026 vbCrLf \u0026 _\r\n               usedInCatalog \u0026 \u0022 provider catalog row(s)\u0022 \u0026 vbCrLf \u0026 _\r\n               usedInNeeds \u0026 \u0022 client need row(s)\u0022 \u0026 vbCrLf \u0026 vbCrLf \u0026 _\r\n               \u0022reference it. Consider unchecking \u0027Active\u0027 instead.\u0022, _\r\n               vbExclamation, \u0022Service In Use\u0022\r\n        Exit Sub\r\n    End If\r\n    If MsgBox(\u0022Delete this service?\u0022, _\r\n              vbYesNo \u002B vbQuestion \u002B vbDefaultButton2, _\r\n              \u0022Confirm Delete\u0022) = vbNo Then Exit Sub\r\n    On Error GoTo Failed\r\n    RunCommand acCmdSelectRecord\r\n    RunCommand acCmdDeleteRecord\r\n    DoCmd.Close acForm, Me.name\r\n    Exit Sub\r\nFailed:\r\n    MsgBox \u0022Could not delete: \u0022 \u0026 Err.Description, vbCritical, \u0022Delete Failed\u0022\r\nEnd Sub\r\nPrivate Sub Form_Current()\r\n    \u0027 Window caption\r\n    Me.Caption = Nz(Me.txtServiceName, \u0022New Service\u0022) \u0026 \u0022 - Service Detail\u0022\r\n    \u0027 PK display: locked but visible (not grayed)\r\n    Me.txtServiceID.Locked = True\r\n    Me.txtServiceID.Enabled = True\r\n    Me.txtServiceID.BorderStyle = 0\r\n    Me.txtServiceID.TabStop = False\r\n    \u0027 Button state: clean record =\u003E Save disabled; Delete enabled only on existing\r\n    Me.btnSave.Enabled = False\r\n    On Error Resume Next\r\n    Me.btnDelete.Enabled = Not Me.NewRecord\r\n    On Error GoTo 0\r\nEnd Sub\r\nPrivate Sub Form_Dirty(Cancel As Integer)\r\n    On Error Resume Next\r\n    Me.btnSave.Enabled = True\r\n    On Error GoTo 0\r\nEnd Sub\r\nPrivate Sub Form_Undo(Cancel As Integer)\r\n    On Error Resume Next\r\n    Me.btnSave.Enabled = False\r\n    On Error GoTo 0\r\nEnd Sub\r\n"
}