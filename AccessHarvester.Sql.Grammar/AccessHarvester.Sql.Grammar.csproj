<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AccessHarvester.Sql.Grammar</RootNamespace>
    <AssemblyName>AccessHarvester.Sql.Grammar</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Code generation: Antlr4BuildTasks downloads the ANTLR jar and
      generates C# lexer/parser code from .g4 files at build time
      (requires Java on PATH). Mirrors the AccessHarvester.Vba.Grammar
      wiring established by parser-foundations Session 3.
    -->
    <PackageReference Include="Antlr4BuildTasks" Version="12.8.0" PrivateAssets="all" />
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="JetSql.g4">
      <Package>AccessHarvester.Sql.Grammar.Generated</Package>
      <Listener>true</Listener>
      <Visitor>true</Visitor>
    </Antlr4>
  </ItemGroup>

</Project>
