  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate Sub Report_Open(Cancel As Integer)\r\n    DoCmd.OpenForm \u0022frmReportParam_Provider\u0022, , , , , acDialog\r\n    If Not IsLoaded(\u0022frmReportParam_Provider\u0022) Then\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    Dim provId As Long\r\n    provId = Forms!frmReportParam_Provider!cboProvider  \u0027 Reuses param form\r\n    Me.RecordSource = \u0022SELECT * FROM qryProviderServiceCatalogDetail WHERE ProviderID = \u0022 \u0026 provId\r\n    DoCmd.Close acForm, \u0022frmReportParam_Provider\u0022\r\nEnd Sub\r\nPrivate Sub Report_NoData(Cancel As Integer)\r\n    MsgBox \u0022No service catalog data found for this provider.\u0022, vbInformation\r\n    Cancel = True\r\nEnd Sub\r\nPrivate Function IsLoaded(ByVal strFormName As String) As Boolean\r\n    Dim frm As Access.Form\r\n    For Each frm In Application.Forms\r\n        If frm.name = strFormName Then\r\n            IsLoaded = True\r\n            Exit Function\r\n        End If\r\n    Next\r\n    IsLoaded = False\r\nEnd Function\r\n",
