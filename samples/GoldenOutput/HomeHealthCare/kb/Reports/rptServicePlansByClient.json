  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate m_ProviderID As Long\r\nPrivate m_FiscalYear As Integer\r\nPrivate Sub Report_Open(Cancel As Integer)\r\n    DoCmd.OpenForm \u0022frmReportParam_ProviderFY\u0022, , , , , acDialog\r\n    If Not IsLoaded(\u0022frmReportParam_ProviderFY\u0022) Then\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    m_ProviderID = Forms!frmReportParam_ProviderFY!cboProvider\r\n    m_FiscalYear = Forms!frmReportParam_ProviderFY!cboFiscalYear\r\n    Me.RecordSource = GetSql(m_ProviderID, m_FiscalYear)\r\n    DoCmd.Close acForm, \u0022frmReportParam_ProviderFY\u0022\r\nEnd Sub\r\nPrivate Function GetSql(ByVal ProviderID As Long, ByVal FiscalYear As Long) As String\r\n    Dim sql As String\r\n    sql = \u0022SELECT \u0022\r\n    sql = sql \u0026 \u0022    p.ProviderID, \u0022\r\n    sql = sql \u0026 \u0022    p.ProviderName, \u0022\r\n    sql = sql \u0026 \u0022    s.ServiceID, \u0022\r\n    sql = sql \u0026 \u0022    s.ServiceName, \u0022\r\n    sql = sql \u0026 \u0022    csp.FiscalYear, \u0022\r\n    sql = sql \u0026 \u0022    psc.RatePerHour, \u0022\r\n    sql = sql \u0026 \u0022    csp.HoursPerWeek AS WeeklyHours, \u0022\r\n    sql = sql \u0026 \u0022    csp.WeeklyCost, \u0022\r\n    sql = sql \u0026 \u0022    csp.AnnualEstCost, \u0022\r\n    sql = sql \u0026 \u0022    c.ClientID, \u0022\r\n    sql = sql \u0026 \u0022    Trim(Nz ([LastName], \u0022 \u0026 Chr(34) \u0026 Chr(34) \u0026 \u0022) \u0026 \u0022 \u0026 Chr(34) \u0026 \u0022, \u0022 \u0026 Chr(34) \u0026 \u0022 \u0026 Nz ([FirstName], \u0022 \u0026 Chr(34) \u0026 Chr(34) \u0026 \u0022)) AS ClientName \u0022\r\n    sql = sql \u0026 \u0022FROM \u0022\r\n    sql = sql \u0026 \u0022    tblServices AS s \u0022\r\n    sql = sql \u0026 \u0022    INNER JOIN ( \u0022\r\n    sql = sql \u0026 \u0022        tblProviders AS p \u0022\r\n    sql = sql \u0026 \u0022        INNER JOIN ( \u0022\r\n    sql = sql \u0026 \u0022            ( \u0022\r\n    sql = sql \u0026 \u0022                tblClients AS c \u0022\r\n    sql = sql \u0026 \u0022                INNER JOIN tblClientServiceNeeds AS csn ON c.ClientID = csn.ClientID \u0022\r\n    sql = sql \u0026 \u0022            ) \u0022\r\n    sql = sql \u0026 \u0022            INNER JOIN ( \u0022\r\n    sql = sql \u0026 \u0022                tblProviderServiceCatalog AS psc \u0022\r\n    sql = sql \u0026 \u0022                INNER JOIN tblClientServicePlan AS csp ON psc.ProviderServiceCatalogID = csp.ProviderServiceCatalogID \u0022\r\n    sql = sql \u0026 \u0022            ) ON csn.ClientServiceNeedID = csp.ClientServiceNeedID \u0022\r\n    sql = sql \u0026 \u0022        ) ON p.ProviderID = psc.ProviderID \u0022\r\n    sql = sql \u0026 \u0022    ) ON (s.ServiceID = csn.ServiceID) \u0022\r\n    sql = sql \u0026 \u0022    AND (s.ServiceID = psc.ServiceID) \u0022\r\n    sql = sql \u0026 \u0022WHERE \u0022\r\n    sql = sql \u0026 \u0022    p.ProviderID = \u0022 \u0026 ProviderID \u0026 \u0022 \u0022\r\n    sql = sql \u0026 \u0022    AND psc.FiscalYear = \u0022 \u0026 FiscalYear \u0026 \u0022 \u0022\r\n    sql = sql \u0026 \u0022    AND csp.Status \u003C\u003E \u0027Cancelled\u0027 \u0022\r\n    sql = sql \u0026 \u0022ORDER BY c.LastName, c.FirstName\u0022 \u0026 \u0022;\u0022\r\n    GetSql = sql\r\nEnd Function\r\nPrivate Sub Report_NoData(Cancel As Integer)\r\n    MsgBox \u0022No plan data found for this provider and fiscal year.\u0022, vbInformation\r\n    Cancel = True\r\nEnd Sub\r\nPrivate Function IsLoaded(ByVal strFormName As String) As Boolean\r\n    Dim frm As Access.Form\r\n    For Each frm In Application.Forms\r\n        If frm.name = strFormName Then\r\n            IsLoaded = True\r\n            Exit Function\r\n        End If\r\n    Next\r\n    IsLoaded = False\r\nEnd Function\r\n"
