  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate Sub Form_Open(Cancel As Integer)\r\n    Me.Caption = \u0022Home Health Care Services Tracking \u2014 v1.0\u0022\r\n    \u0027 Check if fiscal years are configured\r\n    If DCount(\u0022*\u0022, \u0022tlkpFiscalYears\u0022, \u0022IsCurrent=True\u0022) = 0 Then\r\n        MsgBox \u0022Warning: No current fiscal year is set in the Fiscal Years lookup table.\u0022 \u0026 vbCrLf \u0026 _\r\n               \u0022Some features may not work correctly.\u0022, vbExclamation, \u0022Configuration Warning\u0022\r\n    End If\r\nEnd Sub\r\nPrivate Sub Form_Timer()\r\n    Me.lblStatusBar.Caption = \u0022  \u0022 \u0026 Format(Now(), \u0022mmmm d, yyyy h:nn AM/PM\u0022) \u0026 _\r\n                              \u0022  |  User: \u0022 \u0026 Environ(\u0022USERNAME\u0022)\r\nEnd Sub\r\nPrivate Sub btnCompactRepair_Click()\r\n    On Error Resume Next\r\n    CommandBars.ExecuteMso \u0022DatabaseCompact\u0022\r\n    If Err.Number \u003C\u003E 0 Then\r\n        MsgBox \u0022Compact and Repair is not available in this context.\u0022, vbInformation\r\n    End If\r\n    On Error GoTo 0\r\nEnd Sub\r\n",
