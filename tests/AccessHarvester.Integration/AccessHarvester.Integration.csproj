<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AccessHarvester.Integration</RootNamespace>
    <AssemblyName>AccessHarvester.Integration</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLI is invoked black-box via Process.Start; we only need the build
         output copied alongside the test assembly, not a managed reference.
         ReferenceOutputAssembly=false keeps Program.Main out of our IL
         (avoiding CA1416 cross-platform warnings on Windows-only APIs). -->
    <ProjectReference Include="..\..\AccessHarvester.Cli\AccessHarvester.Cli.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest"
                      Private="true" />
    <ProjectReference Include="..\..\AccessHarvester.Core\AccessHarvester.Core.csproj" />
    <ProjectReference Include="..\..\AccessHarvester.Pipeline\AccessHarvester.Pipeline.csproj" />
  </ItemGroup>

</Project>
