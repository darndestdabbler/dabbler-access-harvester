  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate m_FiscalYear As Long\r\nPrivate Sub Report_Open(Cancel As Integer)\r\n    DoCmd.OpenForm \u0022frmReportParam_FY\u0022, , , , , acDialog\r\n    If Not IsLoaded(\u0022frmReportParam_FY\u0022) Then\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    m_FiscalYear = Forms!frmReportParam_FY!cboFiscalYear\r\n    Me.RecordSource = GetSql(m_FiscalYear)\r\n    DoCmd.Close acForm, \u0022frmReportParam_FY\u0022\r\nEnd Sub\r\nPrivate Function GetSql(FiscalYear As Long) As String\r\n    Dim sql As String\r\n    sql = \u0022SELECT \u0022\r\n    sql = sql \u0026 \u0022    p.ProviderID, \u0022\r\n    sql = sql \u0026 \u0022    p.ProviderName, \u0022\r\n    sql = sql \u0026 \u0022    csp.FiscalYear, \u0022\r\n    sql = sql \u0026 \u0022    sub.UniqueClientCount AS Clients, \u0022\r\n    sql = sql \u0026 \u0022    Sum(csp.HoursPerWeek * 52) AS Hours, \u0022\r\n    sql = sql \u0026 \u0022    Sum(csp.AnnualEstCost) AS TotalCost, \u0022\r\n    sql = sql \u0026 \u0022    FormatCurrency(Sum(csp.AnnualEstCost) / sub.UniqueClientCount) AS AvgPerClient \u0022\r\n    sql = sql \u0026 \u0022FROM \u0022\r\n    sql = sql \u0026 \u0022    (tblProviders AS p \u0022\r\n    sql = sql \u0026 \u0022    INNER JOIN ( \u0022\r\n    sql = sql \u0026 \u0022        tblProviderServiceCatalog AS psc \u0022\r\n    sql = sql \u0026 \u0022        INNER JOIN tblClientServicePlan AS csp ON psc.ProviderServiceCatalogID = csp.ProviderServiceCatalogID \u0022\r\n    sql = sql \u0026 \u0022    ) ON p.ProviderID = psc.ProviderID) \u0022\r\n    sql = sql \u0026 \u0022    INNER JOIN ( \u0022\r\n    sql = sql \u0026 \u0022        SELECT \u0022\r\n    sql = sql \u0026 \u0022            Dist.ProviderID, \u0022\r\n    sql = sql \u0026 \u0022            Count(Dist.ClientID) AS UniqueClientCount \u0022\r\n    sql = sql \u0026 \u0022        FROM ( \u0022\r\n    sql = sql \u0026 \u0022            SELECT DISTINCT \u0022\r\n    sql = sql \u0026 \u0022                psc2.ProviderID, \u0022\r\n    sql = sql \u0026 \u0022                csn2.ClientID \u0022\r\n    sql = sql \u0026 \u0022            FROM \u0022\r\n    sql = sql \u0026 \u0022                tblProviderServiceCatalog AS psc2 \u0022\r\n    sql = sql \u0026 \u0022                INNER JOIN ( \u0022\r\n    sql = sql \u0026 \u0022                    tblClientServicePlan AS csp2 \u0022\r\n    sql = sql \u0026 \u0022                    INNER JOIN tblClientServiceNeeds AS csn2 ON csp2.ClientServiceNeedID = csn2.ClientServiceNeedID \u0022\r\n    sql = sql \u0026 \u0022                ) ON psc2.ProviderServiceCatalogID = csp2.ProviderServiceCatalogID \u0022\r\n    sql = sql \u0026 \u0022            WHERE csp2.FiscalYear = \u0022 \u0026 FiscalYear \u0026 \u0022 AND csp2.Status \u003C\u003E \u0027Cancelled\u0027 \u0022\r\n    sql = sql \u0026 \u0022        ) AS Dist \u0022\r\n    sql = sql \u0026 \u0022        GROUP BY Dist.ProviderID \u0022\r\n    sql = sql \u0026 \u0022    ) AS sub ON p.ProviderID = sub.ProviderID \u0022\r\n    sql = sql \u0026 \u0022WHERE \u0022\r\n    sql = sql \u0026 \u0022    csp.FiscalYear = \u0022 \u0026 FiscalYear \u0026 \u0022 \u0022\r\n    sql = sql \u0026 \u0022    AND csp.Status \u003C\u003E \u0027Cancelled\u0027 \u0022\r\n    sql = sql \u0026 \u0022GROUP BY \u0022\r\n    sql = sql \u0026 \u0022    p.ProviderID, \u0022\r\n    sql = sql \u0026 \u0022    p.ProviderName, \u0022\r\n    sql = sql \u0026 \u0022    csp.FiscalYear, \u0022\r\n    sql = sql \u0026 \u0022    sub.UniqueClientCount;\u0022\r\n    GetSql = sql\r\nEnd Function\r\nPrivate Sub Report_NoData(Cancel As Integer)\r\n    MsgBox \u0022No provider statistics found for this fiscal year.\u0022, vbInformation\r\n    Cancel = True\r\nEnd Sub\r\nPrivate Function IsLoaded(ByVal strFormName As String) As Boolean\r\n    Dim frm As Access.Form\r\n    For Each frm In Application.Forms\r\n        If frm.name = strFormName Then\r\n            IsLoaded = True\r\n            Exit Function\r\n        End If\r\n    Next\r\n    IsLoaded = False\r\nEnd Function\r\n",
