  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate m_ClientID As Long\r\nPrivate m_DetailCount As Long\r\nPrivate Sub Report_Open(Cancel As Integer)\r\n    If Not IsNull(Me.OpenArgs) Then\r\n        If IsNumeric(Me.OpenArgs) Then\r\n            m_ClientID = CLng(Me.OpenArgs)\r\n            Me.RecordSource = \u0022SELECT * FROM tblClients WHERE ClientID = \u0022 \u0026 m_ClientID\r\n            Exit Sub\r\n        End If\r\n    End If\r\n    DoCmd.OpenForm \u0022frmReportParam_Client\u0022, , , , , acDialog\r\n    If Not IsLoaded(\u0022frmReportParam_Client\u0022) Then\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    m_ClientID = Forms!frmReportParam_Client!cboClient\r\n    Me.RecordSource = \u0022SELECT * FROM tblClients WHERE ClientID = \u0022 \u0026 m_ClientID\r\n    DoCmd.Close acForm, \u0022frmReportParam_Client\u0022\r\nEnd Sub\r\nPrivate Sub Report_NoData(Cancel As Integer)\r\n    MsgBox \u0022No data found for this client.\u0022, vbInformation\r\n    Cancel = True\r\nEnd Sub\r\nPrivate Sub Report_Page()\r\n    \u0027 Draw a horizontal line across the page footer \u2014 migration stress test\r\n    Me.Line (0, Me.ScaleHeight - 200)-(Me.ScaleWidth, Me.ScaleHeight - 200)\r\nEnd Sub\r\nPrivate Sub Detail_Print(Cancel As Integer, PrintCount As Integer)\r\n    m_DetailCount = m_DetailCount \u002B 1\r\nEnd Sub\r\nPrivate Function IsLoaded(ByVal strFormName As String) As Boolean\r\n    Dim frm As Access.Form\r\n    For Each frm In Application.Forms\r\n        If frm.name = strFormName Then\r\n            IsLoaded = True\r\n            Exit Function\r\n        End If\r\n    Next\r\n    IsLoaded = False\r\nEnd Function\r\n",
