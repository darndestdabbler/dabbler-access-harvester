<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AccessHarvester.Core</RootNamespace>
    <AssemblyName>AccessHarvester.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\property-defaults.json" />
    <EmbeddedResource Include="Resources\font-metrics.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessHarvester.Pipeline\AccessHarvester.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Data.OleDb is shipped as a separate NuGet package on .NET 8+;
         required by the classification pipeline (OleDbDaoSchemaReader,
         OleDbValueSampler). Windows-only at runtime, gated by
         [SupportedOSPlatform("windows")] on the calling types. -->
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>

</Project>
