  "VbaCode": "CodeBehindForm\r\nAttribute VB_GlobalNameSpace = False\r\nAttribute VB_Creatable = True\r\nAttribute VB_PredeclaredId = True\r\nAttribute VB_Exposed = False\r\nOption Compare Database\r\nOption Explicit\r\nPrivate m_FiscalYear As Integer\r\nPrivate m_GrandTotal As Currency\r\nPrivate Sub Report_Open(Cancel As Integer)\r\n    DoCmd.OpenForm \u0022frmReportParam_FY\u0022, , , , , acDialog\r\n    If Not IsLoaded(\u0022frmReportParam_FY\u0022) Then\r\n        Cancel = True\r\n        Exit Sub\r\n    End If\r\n    m_FiscalYear = Forms!frmReportParam_FY!cboFiscalYear\r\n    Me.RecordSource = \u0022SELECT ServiceName, TotalCost, PctCost \u0022 \u0026 _\r\n        \u0022FROM qryServiceCosts_ByFiscalYear WHERE FiscalYear = \u0022 \u0026 m_FiscalYear \u0026 \u0022;\u0022\r\n    DoCmd.Close acForm, \u0022frmReportParam_FY\u0022\r\nEnd Sub\r\nPrivate Sub Report_NoData(Cancel As Integer)\r\n    MsgBox \u0022No service cost data found for this fiscal year.\u0022, vbInformation\r\n    Cancel = True\r\nEnd Sub\r\nPrivate Sub Detail_Print(Cancel As Integer, PrintCount As Integer)\r\n    \u0027 Two-pass report logic \u2014 migration stress test\r\n    \u0027If m_GrandTotal \u003E 0 Then\r\n    \u0027    Me.txtPctOfTotal = Format(Nz(Me.txtTotalCost, 0) / m_GrandTotal, \u00220.0%\u0022)\r\n    \u0027Else\r\n    \u0027    Me.txtPctOfTotal = \u00220.0%\u0022\r\n    \u0027End If\r\nEnd Sub\r\nPrivate Sub ReportFooter_Format(Cancel As Integer, FormatCount As Integer)\r\n    \u0027Me.txtGrandTotal = FormatCurrency(m_GrandTotal)\r\nEnd Sub\r\nPrivate Function IsLoaded(ByVal strFormName As String) As Boolean\r\n    Dim frm As Access.Form\r\n    For Each frm In Application.Forms\r\n        If frm.name = strFormName Then\r\n            IsLoaded = True\r\n            Exit Function\r\n        End If\r\n    Next\r\n    IsLoaded = False\r\nEnd Function\r\n",
